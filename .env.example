# ==============================================================================
# AI Website Testing Platform - Environment Configuration
# ==============================================================================

# Application
APP_NAME="AI Website Testing Platform"
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-at-least-32-chars
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_testing_tool
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_testing_tool

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Engine (Ollama / Cloud)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
AI_TIMEOUT_SECONDS=60

# Cloud AI (Optional fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & Evidence
STORAGE_DIR=./storage
MAX_CONCURRENT_BROWSERS=4
BROWSER_DEFAULT_TIMEOUT_MS=30000
DEFAULT_VIEWPORT_WIDTH=1280
DEFAULT_VIEWPORT_HEIGHT=720

# Safety Guardrails
ALLOW_PRIVATE_IPS=False
DEFAULT_SCAN_RATE_LIMIT=10



